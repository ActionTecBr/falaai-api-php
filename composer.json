{
    "name": "actiontecbr/falaai-api",
    "description": "Official PHP SDK for the FalaAI API - AI-powered call transcription, diagnosis and compliance auditing.",
    "keywords": [
        "falaai",
        "api",
        "sdk",
        "call-center",
        "contact-center",
        "speech-to-text",
        "transcription",
        "conversation-intelligence",
        "sentiment-analysis",
        "compliance",
        "audit",
        "copc",
        "iso-18295",
        "lgpd",
        "omnichannel",
        "helpdesk",
        "chatbot",
        "whatsapp",
        "crm",
        "crm-integration",
        "php",
        "rest",
        "api-client"
    ],
    "homepage": "https://falaai.action.tec.br/api",
    "license": "MIT",
    "authors": [
        {
            "name": "Action Tec Br",
            "email": "livio@action.tec.br",
            "homepage": "https://falaai.action.tec.br/api"
        }
    ],
    "support": {
        "issues": "https://github.com/ActionTecBr/falaai-api-php/issues",
        "source": "https://github.com/ActionTecBr/falaai-api-php"
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "FalaAI\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FalaAI\\Tests\\": "tests/"
        }
    }
}
